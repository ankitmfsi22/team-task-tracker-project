      "mcp__linear__unshare_issue",
      "mcp__linear__update_diff",
      "Bash(pnpm install:*)",
      "Bash(pnpm add:*)",
      "Bash(git push:*)",
      "Bash(prisma migrate:*)",
      "Bash(pnpm prisma migrate:*)",
      "Bash(npx prisma migrate:*)",
      "Bash(pnpm exec prisma migrate:*)",
      "Bash(docker compose:*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./**/.env*)",
      "Read(./secrets/**)",
      "Edit(./.env*)",
      "Write(./.env*)",
      "Edit(./secrets/**)",
      "Write(./secrets/**)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(rm -rf:*)"
