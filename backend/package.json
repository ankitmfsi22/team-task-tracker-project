{
  "name": "@team-task-tracker/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/prepare.mjs && tsc -p tsconfig.build.json",
    "typecheck": "node scripts/prepare.mjs && tsc -p tsconfig.json --noEmit",
    "test": "node scripts/prepare.mjs && vitest run",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:check": "prisma db execute --file prisma/check.sql"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@team-task-tracker/shared": "workspace:*",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "jose": "6.2.13",
    "zod": "4.6.7"
  }
}
