{
  "name": "team-task-tracker",
  "version": "0.0.0",
  "private": true,
  "description": "Team Task Tracker monorepo",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "node --test \"scripts/tests/*.test.mjs\" && pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
